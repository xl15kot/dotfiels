/* Rofi — тема как в polybar (Catppuccin Mocha).
   Палитра и шрифт совпадают с ~/.config/polybar/config.ini
   bg #1e1e2e / fg #cdd6f4 / accent #89b4fa / urgent #f38ba8 */

configuration {
    modi: "drun,run,window";
    font: "MesloLGS Nerd Font 11";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{name}";
    drun-match-format: "fuzzy";
    location: 0;
    hide-scrollbar: true;
    cycle: true;
    matching: "normal";
    show-urgent: "urgent";
    display-drun: "";
    display-run: "";
    display-window: "";
}

* {
    base: #1e1e2e;      /* bar background */
    mantle: #181825;    /* inputbar, darker than bar */
    line: #45475a;      /* borders, same spirit as polybar module margins */
    text: #cdd6f4;      /* bar foreground */
    dim: #6c7086;       /* polybar label-empty foreground */
    accent: #89b4fa;    /* polybar label-focused background */
    urgent: #f38ba8;    /* polybar label-urgent background */
    arch: #1793d1;      /* polybar module/arch foreground */
}

window {
    width: 620px;
    height: 420px;
    border: 1px;
    border-color: @line;
    border-radius: 0;
    background-color: @base;
    padding: 0;
    location: center;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 0;
}

inputbar {
    background-color: @mantle;
    border: 0;
    border-bottom: 1px;
    border-bottom-color: @line;
    padding: 10px 12px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @arch;
    font: "MesloLGS Nerd Font Bold 12";
}

entry {
    background-color: transparent;
    text-color: @text;
    placeholder: "Type to search...";
    placeholder-color: @dim;
    cursor: text;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 9;
    spacing: 0;
    fixed-height: false;
    dynamic: true;
    border: 0;
    padding: 6px 0;
}

element {
    background-color: transparent;
    text-color: @text;
    padding: 7px 12px;
    spacing: 12px;
    border-radius: 0;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @text;
}

element normal.urgent,
element alternate.urgent {
    background-color: @urgent;
    text-color: @base;
}

element selected.normal,
element selected.urgent {
    background-color: @accent;
    text-color: @base;
}

element selected.active,
element selected.active.urgent {
    background-color: @accent;
    text-color: @base;
}

element-icon {
    size: 20px;
    background-color: transparent;
    vertical-align: 0.5;
    text-color: @text;
}

element-text {
    background-color: transparent;
    vertical-align: 0.5;
    text-color: inherit;
}

textbox {
    background-color: @mantle;
    text-color: @text;
    border-color: @line;
    padding: 8px 12px;
}
